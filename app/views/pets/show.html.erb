<div class="card shadow">
  <div class="card-body">
    <div class="mb-4 text-center text-md-start">
      <% if @pet.photo.attached? %>
        <%= image_tag @pet.photo, class: "img-fluid rounded shadow-sm", style: "max-width: 300px; height: auto;" %>
      <% else %>
        <div class="bg-light border rounded d-flex align-items-center justify-content-center mx-auto mx-md-0" style="width: 200px; height: 200px;">
          <div class="text-center">
            <i class="bi bi-camera text-muted" style="font-size: 2rem;"></i>
            <p class="text-muted mb-0">No photo available</p>
          </div>
        </div>
      <% end %>
    </div>

    <h1>Mascota: <%= @pet.name %></h1>
    <p><strong>Especie:</strong> <%= @pet.species %> | <strong>Raza:</strong> <%= @pet.breed %></p>
    
    <p><strong>Fecha Nacimiento:</strong> <%= @pet.date_of_birth.strftime("%B %d, %Y") %></p>
    
    <p><strong>Dueño:</strong> <%= link_to "#{@pet.owner.first_name} #{@pet.owner.last_name}", owner_path(@pet.owner) %></p>

    <h3 class="mt-4">Historial de Citas:</h3>
    <table class="table">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Veterinario</th>
          <th>Ver</th>
        </tr>
      </thead>
      <tbody>
        <% @pet.appointments.each do |app| %>
          <tr>
            <td><%= app.appointment_date.strftime("%d/%m/%Y") %></td>
            <td><%= app.vet.last_name %></td>
            <td><%= link_to 'Detalles', appointment_path(app), class: 'btn btn-sm btn-outline-primary' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    
    <div class="mt-3">
      <%= link_to 'Edit Pet', edit_pet_path(@pet), class: 'btn btn-warning' %>
      <%= link_to 'Volver', pets_path, class: 'btn btn-secondary' %>
    </div>
  </div>
</div>